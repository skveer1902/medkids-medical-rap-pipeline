# Copy to .env and edit. Never commit .env.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/medkids.db
OUTPUTS_DIR=./data/outputs

# ---- LLM provider: mock (offline, default) | claude | openai -----------------
LLM_PROVIDER=mock

# Claude (primary). Model ids are configuration, never hard-coded.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Optional output effort: low | medium | high | xhigh | max (leave empty for API default)
CLAUDE_EFFORT=
CLAUDE_USE_STRUCTURED_OUTPUTS=true

# OpenAI (optional secondary)
OPENAI_API_KEY=
OPENAI_MODEL=

# Sampling/limits. Temperature is sent only to providers that support it
# (the current Anthropic SDK does not expose it; it is recorded as unsupported).
# Use LLM_TEMPERATURE=none for OpenAI reasoning models.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_JSON_MAX_ATTEMPTS=3
# Optional: USD per million tokens, for cost estimates (check current provider pricing)
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# ---- Pipeline ------------------------------------------------------------
MAX_REVISION_ATTEMPTS=3
SOFT_SCORE_PASS_THRESHOLD=80
# JSON; keys must be exactly these and sum to 1.0
SCORE_WEIGHTS={"medical_accuracy":0.30,"educational_coverage":0.25,"age_appropriateness":0.20,"rhyme_rhythm":0.15,"memorability":0.10}
REQUIRED_APPROVAL_ROLES=medical_reviewer,educator
MAX_SOURCE_CHARS=20000
MAX_CANDIDATES_PER_REQUEST=3

# ---- Auth ----------------------------------------------------------------
# name:role:key entries, comma-separated. Roles: author, medical_reviewer, educator, admin.
# Keys must be >= 16 chars. Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
API_KEYS=
AUTH_MODE=api_key
# Development-only header auth (X-Dev-User: name:role). Requires BOTH AUTH_MODE=dev and
# DEV_AUTH_ENABLED=true, and the app refuses to start with it when APP_ENV=production.
DEV_AUTH_ENABLED=false
